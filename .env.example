# Server Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/trackflow?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_32_chars_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_URL=https://trackflow-saas.vercel.app
COOKIE_DOMAIN=

# Optional Cloudinary (for file attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
